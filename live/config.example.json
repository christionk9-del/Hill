{
  "base_url": "https://api.topstepx.com",
  "username_env": "TOPSTEPX_USERNAME",
  "api_key_env": "TOPSTEPX_API_KEY",
  "symbol": "MNQ",
  "accounts": ["REPLACE-WITH-TOPSTEP-ACCOUNT-NAME-1", "REPLACE-WITH-TOPSTEP-ACCOUNT-NAME-2"],
  "contracts_per_account": 1,
  "dry_run": true,
  "entry_mode": "resting",
