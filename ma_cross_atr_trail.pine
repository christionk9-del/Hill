//@version=6
// MA cross + ATR trailing stop. Apply to MES1! on the Daily chart.
// Same rules as backtest.py: signals on bar close, fills on next bar open,
// stop ratchets on each close, re-entry only on a fresh cross.
strategy("MA Cross + ATR Trailing Stop", overlay = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
     slippage = 1)

fastLen    = input.int(10, "Fast EMA", minval = 1)
slowLen    = input.int(30, "Slow EMA", minval = 2)
atrLen     = input.int(14, "ATR length", minval = 1)
atrMult    = input.float(3.0, "ATR multiplier", minval = 0.1, step = 0.25)
allowShort = input.bool(false, "Allow shorts")
startT     = input.time(timestamp("2026-01-01T00:00:00"), "Backtest start")
endT       = input.time(timestamp("2026-12-31T23:59:00"), "Backtest end")

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
atr  = ta.atr(atrLen)
inWin = time >= startT and time <= endT

longSig  = ta.crossover(fast, slow) and inWin
shortSig = ta.crossunder(fast, slow) and inWin

var float stop = na
if longSig
    strategy.entry("L", strategy.long)
    stop := close - atrMult * atr
else if shortSig
    if allowShort
        strategy.entry("S", strategy.short)
        stop := close + atrMult * atr
    else
        strategy.close("L", comment = "cross")
else if strategy.position_size > 0
    stop := math.max(stop, close - atrMult * atr)
else if strategy.position_size < 0
    stop := math.min(stop, close + atrMult * atr)

if longSig or (strategy.position_size > 0 and not shortSig)
    strategy.exit("L stop", "L", stop = stop, comment = "atr stop")
if (shortSig and allowShort) or (strategy.position_size < 0 and not longSig)
    strategy.exit("S stop", "S", stop = stop, comment = "atr stop")
if not inWin
    strategy.close_all()

plot(fast, "Fast EMA", color.orange)
plot(slow, "Slow EMA", color.blue)
plot(strategy.position_size != 0 ? stop : na, "ATR stop", color.red, style = plot.style_linebr)
